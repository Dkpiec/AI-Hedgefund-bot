# ============================================================
# AI Hedge Fund Bot — Environment Variables
# Copy this to .env and fill in your real values.
# .env is NEVER committed (.gitignore blocks it).
# In production, set these as GitHub Secrets.
# ============================================================

# OpenRouter API (free models supported)
OPENROUTER_API_KEY=your-openrouter-api-key-here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Model selection:
#   openrouter/free              → auto-pick the first available free model
#   deepseek/deepseek-chat-v3.1:free   → DeepSeek V3.1 (free)
#   meta-llama/llama-3.3-70b-instruct:free → Llama 3.3 70B (free)
#   qwen/qwen-2.5-72b-instruct:free    → Qwen 2.5 72B (free)
#   mistralai/mistral-small-24b-instruct-2501:free → Mistral Small (free)
#   google/gemini-2.0-flash-exp:free   → Gemini 2.0 Flash (free)
OPENROUTER_MODEL=openrouter/free

# MT5 Demo Account
MT5_ACCOUNT=your-account-number
MT5_PASSWORD=your-password
MT5_SERVER=MetaQuotes-Demo

# Safety: keep true until MT5 is connected and tested
PAPER_MODE=true
