# ============================================================
# AI Hedge Fund Bot — Environment Variables
# Copy this to .env and fill in your real values.
# .env is NEVER committed (.gitignore blocks it).
# In production, set these as GitHub Secrets.
# ============================================================

# OpenRouter API (free models supported)
OPENROUTER_API_KEY=your-openrouter-api-key-here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Model selection:
#   openrouter/free  → auto-pick the first available free model
OPENROUTER_MODEL=openrouter/free

# ============================================================
# Binance Spot (Testnet by default)
# ============================================================
# Get testnet API keys at: https://testnet.binance.vision/
# (Log in with GitHub, then API Management → New Key)
BINANCE_API_KEY=your-binance-testnet-api-key
BINANCE_API_SECRET=your-binance-testnet-api-secret
BINANCE_TESTNET=true

# Starting testnet account balance in USDT
STARTING_BALANCE=200

# Liquidity / price filters
MAX_PRICE_USD=2000
MIN_24H_VOLUME_USDT=50000000
